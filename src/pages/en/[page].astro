---
import LegalPage from '../../components/legal/LegalPage.astro';
import { getLegal, legalIds } from '../../i18n';

export function getStaticPaths() {
  const legal = getLegal('en');
  return legalIds.map((id) => ({ params: { page: legal.pages[id].slug }, props: { id } }));
}
const { id } = Astro.props;
---
<LegalPage lang="en" id={id} />
