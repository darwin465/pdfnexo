---
const base = Astro.site ?? Astro.url.origin;
const abs = (p: string) => new URL(p, base).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>PDFNexo</title>
    <meta name="description" content="PDFNexo: free online PDF tools · herramientas PDF gratis online." />
    <link rel="canonical" href={abs('/')} />
    <link rel="alternate" hreflang="es" href={abs('/es/')} />
    <link rel="alternate" hreflang="en" href={abs('/en/')} />
    <link rel="alternate" hreflang="x-default" href={abs('/')} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:ui-sans-serif,system-ui,sans-serif;background:#f8fafc;color:#0f172a}
      main{text-align:center;padding:1.5rem}
      h1{color:#14215c;font-size:2rem;margin:0 0 1.5rem}
      a{display:inline-block;margin:.35rem;padding:.8rem 1.4rem;border-radius:.75rem;background:#243aa3;color:#fff;text-decoration:none;font-weight:600}
      a:focus-visible{outline:2px solid #7c3aed;outline-offset:2px}
    </style>
  </head>
  <body>
    <main>
      <h1>PDF<span style="color:#7c3aed">Nexo</span></h1>
      <p><a href="/es/" hreflang="es" lang="es">Español</a><a href="/en/" hreflang="en" lang="en">English</a></p>
    </main>
    <script is:inline>
      try {
        if (!/[?&]stay=1/.test(location.search)) {
          location.replace((navigator.language || 'en').toLowerCase().startsWith('es') ? '/es/' : '/en/');
        }
      } catch (e) {}
    </script>
  </body>
</html>
