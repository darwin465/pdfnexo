---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToolCard from './ToolCard';
import ToolMount from './ToolMount.astro';
import AdRectangle from '../ads/AdRectangle.astro';
import { getDict, getLegal, getToolContent, getUi, homePath, toolPath, type Lang } from '../../i18n';
import { getTool, type ToolId } from '../../data/tools';
import { getToolViews } from '../../lib/toolViews';

interface Props { lang: Lang; toolId: ToolId }
const { lang, toolId } = Astro.props;
const t = getDict(lang);
const ui = getUi(lang);
const legal = getLegal(lang);
const tool = getTool(toolId);
const text = t.tools[toolId];
const content = getToolContent(lang, toolId);
const alternates = { es: toolPath('es', toolId), en: toolPath('en', toolId) };
const related = getToolViews(lang, (x) => x.id !== toolId).slice(0, 3);
const base = Astro.site ?? Astro.url.origin;
const abs = (p: string) => new URL(p, base).href;
const howToTitle = lang === 'es' ? 'Cómo usar esta herramienta' : 'How to use this tool';
const faqTitle = t.faq.title;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.toolPage.breadcrumbHome, item: abs(homePath(lang)) },
      { '@type': 'ListItem', position: 2, name: text.name, item: abs(toolPath(lang, toolId)) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: text.name,
    description: text.description,
    url: abs(toolPath(lang, toolId)),
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any',
    inLanguage: lang,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: content.faq.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })),
  },
];
---
<BaseLayout title={text.title} description={text.description} lang={lang} alternates={alternates} noindex={!tool.available}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="mx-auto max-w-4xl px-4 pt-10 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <ol class="flex items-center gap-2">
        <li><a href={homePath(lang)} class="hover:text-brand-700">{t.toolPage.breadcrumbHome}</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-slate-700">{text.name}</li>
      </ol>
    </nav>

    <h1 class="mt-6 text-3xl font-bold tracking-tight text-brand-900 sm:text-4xl">{text.name}</h1>
    <p class="mt-3 max-w-2xl text-lg text-slate-600">{text.description}</p>

    <div class="mt-8">
      {tool.available ? (
        <ToolMount lang={lang} toolId={toolId} />
      ) : (
        <div role="status" class="rounded-2xl border border-accent-100 bg-accent-50 p-6">
          <h2 class="font-semibold text-accent-600">{t.toolPage.devTitle}</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-700">{t.toolPage.devText}</p>
        </div>
      )}
      <noscript><p class="mt-4 text-sm text-red-700">{lang === 'es' ? 'Esta herramienta necesita JavaScript.' : 'This tool needs JavaScript.'}</p></noscript>
    </div>
  </div>

  <section class="mx-auto mt-20 max-w-4xl px-4 sm:px-6">
    <h2 class="text-xl font-semibold text-slate-900">{howToTitle}</h2>
    <ol class="mt-5 space-y-3">
      {content.steps.map((step, i) => (
        <li class="flex gap-4 rounded-xl border border-slate-200 bg-white p-4">
          <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-brand-700 text-sm font-bold text-white">{i + 1}</span>
          <span class="pt-1 text-slate-700">{step}</span>
        </li>
      ))}
    </ol>
  </section>

  <AdRectangle slot="tool" label={legal.adLabel} />

  <section class="mx-auto mt-16 max-w-4xl px-4 sm:px-6">
    <h2 class="text-xl font-semibold text-slate-900">{faqTitle}</h2>
    <div class="mt-5 space-y-3">
      {content.faq.map((item) => (
        <details class="group rounded-xl border border-slate-200 bg-white p-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium text-slate-900 [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="text-xl leading-none text-slate-400 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="mx-auto mt-16 max-w-4xl px-4 sm:px-6">
    <h2 class="mb-5 text-xl font-semibold text-slate-900">{t.toolPage.related}</h2>
    <ul class="grid gap-4 sm:grid-cols-3">
      {related.map((r) => <li><ToolCard tool={r} /></li>)}
    </ul>
  </section>
</BaseLayout>
