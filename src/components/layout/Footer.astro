---
import Logo from './Logo.astro';
import DonateButton from '../common/DonateButton.astro';
import { getDict, getLegal, legalIds, legalPath, homePath, toolPath, languages, type Lang } from '../../i18n';
import { tools } from '../../data/tools';

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = getDict(lang);
const legal = getLegal(lang);
const year = new Date().getFullYear();
const footerTools = tools.filter((x) => x.popular);
---
<footer class="mt-24 border-t border-slate-200 bg-white">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-4">
    <div>
      <Logo href={homePath(lang)} name={t.siteName} />
      <p class="mt-3 max-w-xs text-sm leading-relaxed text-slate-600">{t.tagline}.</p>
      <div class="mt-4"><DonateButton lang={lang} /></div>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-slate-900">{t.footer.tools}</h2>
      <ul class="mt-3 space-y-2">
        {footerTools.map((tool) => (
          <li><a href={toolPath(lang, tool.id)} class="text-sm text-slate-600 hover:text-brand-700">{t.tools[tool.id].name}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-slate-900">PDFNexo</h2>
      <ul class="mt-3 space-y-2">
        {legalIds.map((id) => (
          <li><a href={legalPath(lang, id)} class="text-sm text-slate-600 hover:text-brand-700">{legal.label[id]}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <h2 class="text-sm font-semibold text-slate-900">{t.footer.language}</h2>
      <ul class="mt-3 space-y-2">
        {languages.map((code) => (
          <li>
            <a href={alternates[code]} hreflang={code} lang={code} class="text-sm text-slate-600 hover:text-brand-700">
              {code === 'es' ? 'Español' : 'English'}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
  <div class="border-t border-slate-100 py-5 text-center text-xs text-slate-500">
    © {year} PDFNexo. {t.footer.rights}
  </div>
</footer>
