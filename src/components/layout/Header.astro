---
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import Icon from '../common/Icon';
import { getDict, getGuides, homePath, type Lang } from '../../i18n';

interface Props { lang: Lang; alternates: Record<Lang, string> }
const { lang, alternates } = Astro.props;
const t = getDict(lang);
const links = [
  { href: `${homePath(lang)}#tools`, label: t.nav.tools },
  { href: `${homePath(lang)}#guides`, label: getGuides(lang).breadcrumb },
  { href: `${homePath(lang)}#faq`, label: t.nav.faq },
];
---
<header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <Logo href={homePath(lang)} name={t.siteName} />

    <nav aria-label="Principal" class="hidden items-center gap-6 md:flex">
      {links.map((l) => (
        <a href={l.href} class="text-sm font-medium text-slate-600 transition hover:text-brand-700">{l.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <LanguageSwitcher lang={lang} alternates={alternates} label={t.nav.language} />
      <details class="relative md:hidden">
        <summary class="flex h-9 w-9 cursor-pointer list-none items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 [&::-webkit-details-marker]:hidden" aria-label={t.nav.menu}>
          <Icon name="menu" size={20} />
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-xl border border-slate-200 bg-white p-2 shadow-card-hover">
          {links.map((l) => (
            <a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-50">{l.label}</a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
