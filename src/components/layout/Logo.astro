---
interface Props { href: string; name: string; light?: boolean }
const { href, name, light = false } = Astro.props;
---
<a href={href} class="inline-flex items-center gap-2 text-lg font-bold tracking-tight" aria-label={name}>
  <svg width="30" height="30" viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="#1c2e80" />
    <path d="M20 11h16l11 11v28a3 3 0 0 1-3 3H20a3 3 0 0 1-3-3V14a3 3 0 0 1 3-3z" fill="#fff" />
    <path d="M36 11v8a3 3 0 0 0 3 3h8z" fill="#c4b5fd" />
    <path d="M26 34h12M26 34l6 10M38 34l-6 10" stroke="#7c3aed" stroke-width="2.2" stroke-linecap="round" fill="none" />
    <g fill="#7c3aed"><circle cx="26" cy="34" r="3.6" /><circle cx="38" cy="34" r="3.6" /><circle cx="32" cy="44" r="3.6" /></g>
  </svg>
  <span class:list={[light ? 'text-white' : 'text-brand-900']}>PDF<span class="text-accent-600">Nexo</span></span>
</a>
