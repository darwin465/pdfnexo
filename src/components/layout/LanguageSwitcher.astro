---
import { languages, type Lang } from '../../i18n';

interface Props { lang: Lang; alternates: Record<Lang, string>; label: string }
const { lang, alternates, label } = Astro.props;
---
<nav aria-label={label} class="flex items-center rounded-lg border border-slate-200 bg-white p-0.5 text-sm font-medium">
  {languages.map((code) => (
    <a
      href={alternates[code]}
      hreflang={code}
      lang={code}
      aria-current={code === lang ? 'true' : undefined}
      class:list={[
        'rounded-md px-2.5 py-1 uppercase transition',
        code === lang ? 'bg-brand-700 text-white' : 'text-slate-600 hover:bg-slate-100',
      ]}
    >{code}</a>
  ))}
</nav>
