---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CookieSettings from './CookieSettings';
import { getDict, getLegal, homePath, legalPath, type Lang, type LegalId } from '../../i18n';

interface Props { lang: Lang; id: LegalId }
const { lang, id } = Astro.props;
const legal = getLegal(lang);
const page = legal.pages[id];
const t = getDict(lang);
const alternates = { es: legalPath('es', id), en: legalPath('en', id) };
const operator = (import.meta.env.PUBLIC_OPERATOR_NAME as string | undefined) || legal.operatorMissing;
const email = (import.meta.env.PUBLIC_CONTACT_EMAIL as string | undefined) || '';
const fill = (text: string) => text.replace('{operator}', operator).replace('{email}', email || '[PUBLIC_CONTACT_EMAIL]');
const adsEnabled = Boolean(import.meta.env.PUBLIC_ADSENSE_CLIENT);
---
<BaseLayout title={`${page.title} | PDFNexo`} description={page.description} lang={lang} alternates={alternates}>
  <article class="mx-auto max-w-3xl px-4 pt-12 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-sm text-slate-500">
      <a href={homePath(lang)} class="hover:text-brand-700">{t.toolPage.breadcrumbHome}</a> <span aria-hidden="true">/</span> <span class="text-slate-700">{legal.label[id]}</span>
    </nav>
    <h1 class="mt-6 text-3xl font-bold tracking-tight text-brand-900">{page.title}</h1>
    {(id === 'privacy' || id === 'terms' || id === 'cookies') && <p class="mt-2 text-sm text-slate-500">{legal.updated}</p>}
    <div class="mt-8 space-y-8">
      {page.sections.map((section) => (
        <section>
          <h2 class="text-xl font-semibold text-slate-900">{section.h}</h2>
          {section.p.map((paragraph) => <p class="mt-3 leading-relaxed text-slate-700">{fill(paragraph)}</p>)}
        </section>
      ))}
    </div>
    {id === 'contact' && (
      <p class="mt-8 rounded-xl border border-slate-200 bg-white p-5 text-slate-800">
        {email
          ? <><span class="font-medium">{legal.contactEmailLabel}:</span> <a class="text-brand-700 underline" href={`mailto:${email}`}>{email}</a></>
          : legal.contactMissing}
      </p>
    )}
    {id === 'cookies' && adsEnabled && <CookieSettings client:load label={legal.cookieSettings.button} hint={legal.cookieSettings.hint} />}
  </article>
</BaseLayout>
