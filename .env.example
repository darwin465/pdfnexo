# URL pública del sitio (canonical, hreflang, sitemap). Sin barra final.
SITE_URL=https://example.com

# Datos del titular (se muestran en privacidad y contacto). Obligatorios antes de publicar.
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=

# Botón de donación (enlace https de Ko-fi, Buy Me a Coffee, PayPal.me, etc.). Vacío = no se muestra.
PUBLIC_DONATE_URL=

# AdSense. Déjalos vacíos hasta tener la cuenta aprobada: sin ellos no se renderiza ningún anuncio.
# Formato del cliente: ca-pub-XXXXXXXXXXXXXXXX (lo facilita Google).
PUBLIC_ADSENSE_CLIENT=
PUBLIC_ADSENSE_SLOT_HEADER=
PUBLIC_ADSENSE_SLOT_CONTENT=
PUBLIC_ADSENSE_SLOT_TOOL=
PUBLIC_ADSENSE_SLOT_ARTICLE=
